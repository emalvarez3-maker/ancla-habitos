    <string name="whatsapp_listener_label">Dexter · WhatsApp messages</string>
    <string name="whatsapp_title">WhatsApp</string>
    <string name="whatsapp_explain">Dexter can read and summarize your WhatsApp messages. The app reads only WhatsApp\'s notifications (other apps are ignored), encrypts each message as it arrives and can decrypt them only with the phone unlocked. They\'re not backed up, they delete themselves, and only the ones you ask Dexter about leave the phone, to your AI provider. Only messages arriving after you turn it on are kept. Dexter can\'t send messages.</string>
    <string name="whatsapp_lock_ok">✓ Secure screen lock</string>
    <string name="whatsapp_lock_missing">✕ No secure screen lock</string>
    <string name="whatsapp_access_ok">✓ Notification access granted</string>
    <string name="whatsapp_access_missing">✕ Notification access missing</string>
